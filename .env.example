# ─────────────────────────────────────────────────────────────────
# AgentShield Core — Environment Variables
# Copy to .env and fill in values.  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # Set to "production" on Railway / server

# ── Database ──────────────────────────────────────────────────────
# Path to the SQLite file.
# On Railway with a volume at /data:  DATABASE_PATH=/data/shield.db
DATABASE_PATH=./shield.db

# ── Workspace & API Keys ──────────────────────────────────────────
# Workspace ID used when generating new API keys via POST /api/keys.
# Defaults to "default". Must match a row in the workspaces table.
DEFAULT_WORKSPACE_ID=default
WORKSPACE_ID=default

# Admin secret for POST/GET/DELETE /api/keys (key management endpoints).
# Set to a strong random string. Keep private.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_SECRET=

# ── CORS ──────────────────────────────────────────────────────────
# Set to your frontend origin. Defaults to * if not set.
CORS_ORIGIN=http://localhost:3000

# ── Telegram Approval Alerts (optional) ───────────────────────────
# When an action is PAUSED for approval, AgentShield sends a Telegram message.
# Get a bot token from @BotFather and find your chat ID with @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Razorpay Billing ──────────────────────────────────────────
# Get from Razorpay dashboard → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Get from Razorpay dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Brevo) — for API key delivery after payment ────────
BREVO_API_KEY=
EMAIL_FROM=noreply@allkinz.com
